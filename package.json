{
  "name": "@shadow-js/eslint-plugin",
  "version": "1.0.0",
  "description": "ESLint rules for reactivity, ownership and security, and for migrating code from React or Solid",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/dev/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/prod/index.js"
    },
    "./parser": {
      "types": "./dist/dev/parser.d.ts",
      "development": "./dist/dev/parser.js",
      "default": "./dist/prod/parser.js"
    },
    "./docs": {
      "types": "./dist/dev/docs.d.ts",
      "development": "./dist/dev/docs.js",
      "default": "./dist/prod/docs.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck:types",
    "typecheck:types": "tsc -p tsconfig.test-types.json",
    "docs": "tsdown --config-loader native && node scripts/generate-docs.mjs",
    "lint": "biome check .",
    "test": "vitest run --project unit --project dom --project server",
    "test:gc": "vitest run --project gc --passWithNoTests",
    "test:perf": "vitest run --project perf --passWithNoTests",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run test:perf && npm run test:gc"
  },
  "dependencies": {
    "@typescript-eslint/scope-manager": "8.71.2",
    "@typescript-eslint/visitor-keys": "8.71.2",
    "oxc-parser": "0.154.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "10.12.0",
    "happy-dom": "^21.0.3",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "keywords": [
    "shadowjs",
    "eslint",
    "eslintplugin",
    "reactivity",
    "signals",
    "eslint-plugin"
  ],
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "homepage": "https://eslint.shadowjs.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadowjs-dev/eslint-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/shadowjs-dev/eslint-plugin/issues"
  }
}
